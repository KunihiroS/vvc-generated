<div class="horizontal-scroll" data-horizontal-scroll>
  <button class="horizontal-scroll__arrow" type="button" data-scroll-back aria-label="Scroll filters left" hidden disabled>
    <span aria-hidden="true">←</span>
  </button>
  <div class="horizontal-scroll__viewport" data-scroll-viewport>
    <div class="horizontal-scroll__content" data-scroll-content>
      <slot />
    </div>
  </div>
  <button class="horizontal-scroll__arrow" type="button" data-scroll-forward aria-label="Scroll filters right" hidden disabled>
    <span aria-hidden="true">→</span>
  </button>
</div>

<style>
  .horizontal-scroll {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    max-width: 100%;
    width: 100%;
    box-sizing: border-box;
  }

  .horizontal-scroll__viewport {
    flex: 1;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    padding: 4px;
    box-sizing: border-box;
  }

  .horizontal-scroll__content {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
  }

  .horizontal-scroll__arrow {
    flex: 0 0 36px;
    min-height: 36px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0;
    background: var(--bg-soft);
    color: var(--muted);
    cursor: pointer;
    font: inherit;
  }

  .horizontal-scroll__arrow[hidden] {
    display: none;
  }

  .horizontal-scroll__arrow:hover:not(:disabled) {
    border-color: var(--line-strong);
    color: var(--fg);
  }

  .horizontal-scroll__arrow:disabled {
    opacity: .4;
    cursor: default;
  }

  .horizontal-scroll__arrow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-horizontal-scroll]")) {
    const viewport = root.querySelector<HTMLElement>("[data-scroll-viewport]");
    const content = root.querySelector<HTMLElement>("[data-scroll-content]");
    const back = root.querySelector<HTMLButtonElement>("[data-scroll-back]");
    const forward = root.querySelector<HTMLButtonElement>("[data-scroll-forward]");
    if (!viewport || !content || !back || !forward) continue;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let pendingFrame = 0;

    function measure() {
      pendingFrame = 0;
      const style = getComputedStyle(viewport);
      const focusPadding = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
      const contentWidth = content.getBoundingClientRect().width;
      // Use the arrow-free width so showing arrows cannot sustain false overflow.
      const overflowing = contentWidth + focusPadding > root.clientWidth + 1;
      back.hidden = !overflowing;
      forward.hidden = !overflowing;

      const maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
      back.disabled = !overflowing || viewport.scrollLeft <= 1;
      forward.disabled = !overflowing || viewport.scrollLeft >= maxScroll - 1;
    }

    function scheduleMeasure() {
      if (!pendingFrame) pendingFrame = requestAnimationFrame(measure);
    }

    function scrollPage(direction: number) {
      viewport.scrollBy({
        left: direction * viewport.clientWidth * .8,
        behavior: reducedMotion.matches ? "auto" : "smooth",
      });
    }

    back.addEventListener("click", () => scrollPage(-1));
    forward.addEventListener("click", () => scrollPage(1));
    viewport.addEventListener("scroll", scheduleMeasure, { passive: true });
    viewport.addEventListener("focusin", (event) => {
      if (!(event.target instanceof HTMLElement)) return;
      const target = event.target.getBoundingClientRect();
      const bounds = viewport.getBoundingClientRect();
      const style = getComputedStyle(viewport);
      const left = bounds.left + viewport.clientLeft + parseFloat(style.paddingLeft);
      const right = bounds.left + viewport.clientLeft + viewport.clientWidth - parseFloat(style.paddingRight);
      const distance = target.left < left ? target.left - left : target.right > right ? target.right - right : 0;
      if (distance) viewport.scrollBy({ left: distance, behavior: "auto" });
    });

    const observer = new ResizeObserver(scheduleMeasure);
    observer.observe(root);
    observer.observe(content);
    document.fonts.ready.then(scheduleMeasure);
    document.fonts.addEventListener("loadingdone", scheduleMeasure);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) scheduleMeasure();
    });
    scheduleMeasure();
  }
</script>
